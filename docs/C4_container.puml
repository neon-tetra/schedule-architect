@startuml c4_container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title schedule-architect: Container Diagram

Person(user, "Workforce Planner", "Explores a staffing scenario through natural language")

System_Boundary(sa, "schedule-architect") {

    Container(browser, "Browser Client", "Chainlit / WebSocket", "Renders conversation and Plotly charts. Stock Chainlit — no custom frontend code.")

    Container(app, "app.py", "Python / Chainlit hooks", "Entry point. Owns on_chat_start and on_message. Drives the agent turn, streams tokens, and renders Plotly figures returned by the presentation layer.")

    Container(agent, "Agent Layer", "Python — agent/", "Owns the full LLM turn lifecycle. AgentSession manages conversation history, prompt assembly (with caching), streaming, and the tool loop. ResponseParser extracts display text, summary, and chart tags from raw responses. Toolkit exposes domain tools to the model.")

    Container(core, "Core Layer", "Python — core/", "Domain entities and session state. QueueProfile, Roster, RosterEntry define the scenario model. ScenarioContext holds live roster and solve history. SlotMatrix is the shared (day, slot, skill) → int structure used by solver and presentation. SolveRun carries demand, supply, and shortfall matrices for a completed solve.")

    Container(solver, "Solver Layer", "Python — solver/", "Stateless optimisation. ErlangC derives per-interval staffing requirements from queue parameters. ModelBuilder constructs and solves the CP-SAT model, returning a SolveRun.")

    Container(presentation, "Presentation Layer", "Python — presentation/", "Chart construction. Builds Plotly Figure objects from SolveRun data. Called by app.py after each tool loop completes.")

}

System_Ext(anthropic, "Anthropic API", "claude-opus-4-5. Streaming completions, tool use, prompt caching via AsyncAnthropic.")

Rel(user, browser, "Interacts with", "HTTPS / WebSocket")
Rel(browser, app, "on_message / on_chat_start", "Chainlit hook")
Rel(app, agent, "run_turn(text, on_token)")
Rel(app, presentation, "build_figures(solve_run)")
Rel(app, browser, "stream_token / cl.Plotly(fig)", "Chainlit API")
Rel(agent, anthropic, "messages + system + tools", "HTTPS stream")
Rel(agent, core, "reads/writes ScenarioContext, SolveRun")
Rel(agent, solver, "ErlangC.requirements_curve(), ModelBuilder.build_and_solve()")
Rel(solver, core, "reads Roster, QueueProfile / returns SolveRun")
Rel(presentation, core, "reads SolveRun, SlotMatrix")

@enduml