@startuml agent_classes

skinparam backgroundColor #D3D3D3
skinparam defaultFontName Segoe UI

skinparam class {
    BackgroundColor #FAFAFA
    BorderColor #555555
    FontColor #222222
    BackgroundColor<<deferred>> #E8E8E8
    BorderColor<<deferred>> #AAAAAA
    FontColor<<deferred>> #AAAAAA
    BorderStyle<<deferred>> dashed
}

skinparam legend {
    BackgroundColor #FAFAFA
    BorderColor #555555
}

legend top right
  <#FAFAFA,#555555>|                         |
  | Normal member      | Implemented          |
  | <color:#999999>~ member</color>  | Deferred / future    |
  | <<deferred>> class | Placeholder only     |
endlegend

' ─────────────────────────────────────────
' PACKAGE: Agent
' ─────────────────────────────────────────
package "Agent" <<Rectangle>> {

    class AgentSession {
        + session_id : str
        + model : str
        - _client : Anthropic
        - _context : ScenarioContext
        - _builder : SystemPromptBuilder
        - _conversation : ConversationManager
        - _tools : AgentTools
        - _last_presentation : str | None
        --
        + run_turn(user_message: str) : str
        <color:#999999>~ swap_model(model: str) : None</color>
    }

    class AgentTools {
        - _dispatcher : Dispatcher
        - _context : ScenarioContext
        --
        + get_tools() : list[BetaTool]
        ' tool closures include define_queue_profile,
        ' derive_erlang, define_roster,
        ' solve, read_result, read_roster
        ' each closure: construct Command,
        ' dispatch, return json.dumps(result.data)
        ' each closure decorated with @beta_tool
        ' docstrings are agent-facing descriptions
        ' deferred: add_to_roster
        ' deferred: subtract_from_roster
    }

    class SystemPromptBuilder {
        - _static_sections : list[PromptSection]
        - _dynamic_sections : list[PromptSection]
        --
        + add_static_section(heading: str, content: str) : SystemPromptBuilder
        + add_dynamic_section(heading: str, content: str) : SystemPromptBuilder
        + build() : str
        - _build_static_prefix() : str
        - _build_dynamic_suffix() : str
    }

    class ConversationManager {
        - _messages : list[dict]
        - _max_turns : int
        --
        + add_user_message(content: str) : None
        + add_assistant_message(content: str) : None
        + get_messages() : list[dict]
        + trim() : None
        <color:#999999>~ summarise(client: Anthropic) : None</color>
    }

    class PromptSection {
        + heading : str
        + content : str
        + dynamic : bool
    }

    class WorkspaceManager <<deferred>> {
        ' placeholder - deferred
        ' ScenarioContext currently lives in Engine
        ' will migrate here when multi-scenario
        ' or webapp support is needed
        <color:#999999>~ get_context(scenario_id: str) : ScenarioContext</color>
        <color:#999999>~ list_scenarios() : list[str]</color>
    }

}

' ─────────────────────────────────────────
' PACKAGE: Engine (existing)
' ─────────────────────────────────────────
package "Engine" <<Rectangle>> {

    class Dispatcher {
        ' existing - no changes
    }

    class ScenarioContext {
        ' existing - no changes
        ' note: candidate to migrate to
        ' WorkspaceManager post-MVP
    }

}

' ─────────────────────────────────────────
' RELATIONSHIPS
' ─────────────────────────────────────────
AgentSession "1" *-- "1" SystemPromptBuilder : owns
AgentSession "1" *-- "1" ConversationManager : owns
AgentSession "1" *-- "1" AgentTools : owns
AgentTools "1" --> "1" Dispatcher : uses (ref)
AgentTools "1" --> "1" ScenarioContext : reads (ref)
SystemPromptBuilder "1" *-- "many" PromptSection : owns
WorkspaceManager ..> ScenarioContext : will own
AgentSession ..> ScenarioContext : reads for dynamic sections
Dispatcher --> ScenarioContext : reads/writes (existing)

@enduml