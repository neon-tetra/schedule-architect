@startuml agent_activity

skinparam backgroundColor #D3D3D3
skinparam defaultFontName Segoe UI

|Caller|
|AgentSession|
|Anthropic / tool_runner|
|Tools|
|Memory|

|Caller|
start
:Submit user message;

|AgentSession|
:ConversationManager\nadd_user_message();
:Read Memory\nfor dynamic prompt sections;

|Memory|
:Return current state\n(queues, demand, roster,\nsolve_result summary);

|AgentSession|
:SystemPromptBuilder.build()\n— static prefix + dynamic suffix;
:ConversationManager\nget_messages();
:AgentTools.get_tools()\n— @beta_tool decorated methods;
:Call tool_runner(\n  model, system, tools, messages\n);

|Anthropic / tool_runner|
:Receive prompt +\nconversation history;
:Reason;

note right
  Tool calls: 0..n
  Claude decides if and how many
  tool calls are needed per turn.
  Loop repeats until stop_reason
  is no longer tool_use.
end note

repeat

  if (tool call needed?) then (yes)
    :Emit tool_use block\nwith tool name + args;

    |Tools|
    :@beta_tool method invoked\nwith Claude's args;
    :Construct Command\nfrom args;
    :Dispatcher.dispatch(cmd);

    |Memory|
    :Read / write ScenarioContext\nper command type;
    :Return;

    |Tools|
    :Wrap CommandResult\nas json string;
    :Return tool result\nto tool_runner;

    |Anthropic / tool_runner|
    :Receive tool result;
    :Reason;

  else (no tool call)

  endif

repeat while (stop_reason == tool_use?) is (yes)
-> no;

:Return final BetaMessage;

|AgentSession|
:ConversationManager\nadd_assistant_message();
:Extract response text;

|Caller|
:Receive response text;
stop

@enduml