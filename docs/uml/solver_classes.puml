@startuml solver_classes

skinparam backgroundColor #D3D3D3
skinparam defaultFontName Segoe UI

skinparam class {
    BackgroundColor #FAFAFA
    BorderColor #555555
    FontColor #222222
    BackgroundColor<<deferred>> #E8E8E8
    BorderColor<<deferred>> #AAAAAA
    FontColor<<deferred>> #AAAAAA
    BorderStyle<<deferred>> dashed
}

skinparam legend {
    BackgroundColor #FAFAFA
    BorderColor #555555
}

legend top right
  <#FAFAFA,#555555>|                         |
  | Normal member      | Implemented          |
  | <color:#999999>~ member</color>  | Deferred / future    |
  | <<deferred>> class | Placeholder only     |
endlegend

' ─────────────────────────────────────────
' PACKAGE: Solver
' ─────────────────────────────────────────
package "Solver" <<Rectangle>> {

    class ErlangC {
        ..stateless class methods..
        + wait_probability(arrival_rate, aht_seconds, agents) : float
        + service_level(arrival_rate, aht_seconds, agents, answer_within_seconds) : float
        + minimum_agents(arrival_rate, aht_seconds, target_service_level, answer_within_seconds) : int
        + requirements_curve(env: QueueProfile, target_service_level, answer_within_seconds, shrinkage) : SlotMatrix
        --
        note: all methods are @classmethod
    }

    class VarRegistry {
        - _entries : list
        - _index : defaultdict
        --
        + add(obj, **tags) : None
        + query(**tags) : list
        + query_one(**tags) : any
        + __len__() : int
        + __repr__() : str
    }

    class ModelBuilder {
        --
        + build_and_solve(roster: Roster, queues: dict[str, QueueProfile], demand: SlotMatrix) : SolverOutput
        note: intentionally monolithic for MVP —\ndynamic constraint building deferred
    }

    class SolverOutput {
        + status : str
        + solve_time_seconds : float
        + demand : SlotMatrix
        + supply : SlotMatrix
        + shortfall : SlotMatrix
    }

}

' ─────────────────────────────────────────
' NOTES
' ─────────────────────────────────────────
note bottom of ErlangC
    Called directly by Handler (engine layer)
    for MVP simplicity. Long-term home is
    behind a DemandBuilder or similar —
    deliberate architectural shortcut.
end note

' ─────────────────────────────────────────
' RELATIONSHIPS
' ─────────────────────────────────────────
ModelBuilder "1" *-- "1" VarRegistry : uses internally
ModelBuilder ..> SolverOutput : returns
ModelBuilder ..> ErlangC : does not call\n(reads pre-computed demand)

@enduml