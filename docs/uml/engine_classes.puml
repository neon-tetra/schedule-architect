@startuml engine_classes

skinparam backgroundColor #D3D3D3
skinparam defaultFontName Segoe UI

skinparam class {
    BackgroundColor #FAFAFA
    BorderColor #555555
    FontColor #222222
    BackgroundColor<<deferred>> #E8E8E8
    BorderColor<<deferred>> #AAAAAA
    FontColor<<deferred>> #AAAAAA
    BorderStyle<<deferred>> dashed
}

skinparam legend {
    BackgroundColor #FAFAFA
    BorderColor #555555
}

legend top right
  <#FAFAFA,#555555>|                         |
  | Normal member      | Implemented          |
  | <color:#999999>~ member</color>  | Deferred / future    |
  | <<deferred>> class | Placeholder only     |
endlegend

' ─────────────────────────────────────────
' PACKAGE: Commands
' ─────────────────────────────────────────
package "Commands" <<Rectangle>> {

    class DefineQueueProfile {
        + type : Literal["define_queue_profile"]
        + skill_id : str
        + weekly_volume : float
        + aht_seconds : float
        + aht_std_seconds : float
        + operating_hours : tuple[int,int]
        + day_weights : list[float]
        + interval_weights : list[float]
    }

    class DeriveErlang {
        + type : Literal["derive_erlang"]
        + target_sl : float
        + answer_within_seconds : float
        + shrinkage : float
    }

    class DefineRoster {
        + type : Literal["define_roster"]
        + entries : list[RosterEntry]
    }

    class Solve {
        + type : Literal["solve"]
    }

    class ReadResult {
        + type : Literal["read_result"]
    }

    note bottom of DefineQueueProfile
        ModelCommand = Union[
          DefineQueueProfile,
          DeriveErlang,
          DefineRoster,
          Solve,
          ReadResult,
        ]
    end note

}

' ─────────────────────────────────────────
' PACKAGE: Engine
' ─────────────────────────────────────────
package "Engine" <<Rectangle>> {

    class SolveResult {
        + status : str
        + solve_time_seconds : float
        + demand : SlotMatrix
        + supply : SlotMatrix
        + shortfall : SlotMatrix
    }

    class CommandResult {
        + success : bool
        + message : str
        + data : dict | None
        --
        + ok(message, data) : CommandResult
        + fail(message) : CommandResult
    }

    class ScenarioContext {
        + name : str
        + queues : dict[str, QueueProfile]
        + demand : SlotMatrix | None
        + current_roster : Roster | None
        + solve_result : SolveResult | None
        --
        + invalidate_solve_results() : None
        <color:#999999>~ is_ready_to_solve() : bool</color>
    }

    class Dispatcher {
        - _handler : Handler
        - _dispatch_table : dict[str, Callable]
        --
        + dispatch(cmd: ModelCommand) : CommandResult
    }

    class Handler {
        - _context : ScenarioContext
        - _model_builder : ModelBuilder
        --
        + handle_define_queue_profile(cmd: DefineQueueProfile) : CommandResult
        + handle_derive_erlang(cmd: DeriveErlang) : CommandResult
        + handle_define_roster(cmd: DefineRoster) : CommandResult
        + handle_solve(cmd: Solve) : CommandResult
        + handle_read_result(cmd: ReadResult) : CommandResult
        <color:#999999>~ handle_read_context(cmd: ReadContext) : CommandResult</color>
    }

    class LLMPresenter {
        - _result : SolveResult
        --
        + present() : str
        + summary_header() : str
        + shortfall_table() : str
        <color:#999999>~ coverage_by_skill() : str</color>
        <color:#999999>~ worst_periods() : str</color>
    }

}

' ─────────────────────────────────────────
' PACKAGE: Solver (external dependency)
' ─────────────────────────────────────────
package "Solver" <<Rectangle>> {

    class ModelBuilder {
        --
        + build_and_solve(roster: Roster, queues: dict[str, QueueProfile], demand: SlotMatrix) : SolverOutput
    }

}

' ─────────────────────────────────────────
' RELATIONSHIPS
' ─────────────────────────────────────────
Dispatcher "1" *-- "1" Handler : owns
Handler "1" --> "1" ScenarioContext : reads/writes
Handler "1" --> "1" ModelBuilder : delegates solve to
Handler "1" --> "1" LLMPresenter : instantiates
LLMPresenter --> SolveResult : reads
Handler ..> SolveResult : assembles from SolverOutput
Dispatcher ..> CommandResult : returns
Handler ..> CommandResult : returns
Handler ..> DefineQueueProfile : accepts
Handler ..> DeriveErlang : accepts
Handler ..> DefineRoster : accepts
Handler ..> Solve : accepts
Handler ..> ReadResult : accepts

@enduml