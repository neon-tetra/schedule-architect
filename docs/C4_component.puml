@startuml c4_component
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_TOP_DOWN()
LAYOUT_WITH_LEGEND()

title schedule-architect: Component Diagram

Person(user, "Workforce Planner", "Explores a staffing scenario through natural language")

System_Ext(chainlit, "Chainlit Browser", "Renders conversation and charts. Stock Chainlit — no custom frontend.")
System_Ext(anthropic, "Anthropic API", "LLM completions via AsyncAnthropic. Streaming, tool use, prompt caching.")

System_Boundary(server, "Chainlit Server") {

    Component(gateway, "Gateway", "Python / Chainlit hooks", "Thin capture layer. Owns on_chat_start and on_message. Tags all inbound events — from Chainlit or Anthropic — and enqueues them. No routing logic. Spins up MediatorLoop as a concurrent task on session start.")

    ComponentQueue(queue, "Event Queue", "asyncio.Queue", "Single inbound channel. All events pass through here — user messages, stream tokens, tool requests, turn completions. Mediator is the only consumer.")

    Component(mediator, "Mediator", "Python / asyncio", "Single consumer of the event queue. Owns the Anthropic streaming call and the tool loop lifecycle. Dispatches each event to Domain by type. Serialises all state mutations.")

    Component(domain, "Domain & Business Logic", "Python", "Handles all events dispatched by Mediator. Manages conversation state, prompt assembly, tool execution, and optimization. Calls Chainlit directly for outbound tokens and chart rendering. Internal structure: engine, solver, presentation layers.")

}

Rel(user, chainlit, "Interacts with", "HTTPS / WebSocket")
Rel(chainlit, gateway, "on_chat_start / on_message", "Chainlit hook")
Rel(mediator, anthropic, "messages + tools / tool_result", "HTTPS stream")
Rel(anthropic, gateway, "text_delta / tool_use / turn_complete", "stream callback")
Rel(gateway, queue, "queue.put(Event)", "asyncio")
Rel(queue, mediator, "queue.get(Event)", "asyncio")
Rel(mediator, domain, "dispatch(event)")
Rel(domain, chainlit, "stream token / render chart", "Chainlit API")

@enduml