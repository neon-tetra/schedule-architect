@startuml seq_agent_turn
' C4 Supplement — Agent Turn Sequence (mediator architecture)

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Sequence.puml

title schedule-architect: Agent Turn Sequence

System_Ext(chainlit, "Chainlit", "Browser client")
Component(gateway, "Gateway", "Python / Chainlit hooks")
ComponentQueue(queue, "Event Queue", "asyncio.Queue")
Component(mediator, "MediatorLoop", "Python / asyncio")
Component(domain, "Domain & Business Logic", "Python")
System_Ext(anthropic, "Anthropic API", "AsyncAnthropic")

== Initialization ==

Rel(chainlit, gateway, "on_chat_start")
Rel(gateway, queue, "create asyncio.Queue()")
Rel(gateway, mediator, "create_task(mediator_loop)")
Rel(gateway, chainlit, "session ready")

== User Turn ==

Rel(chainlit, gateway, "on_message(text)")
Rel(gateway, queue, "queue.put(Event(CHAINLIT, USER_MESSAGE))")
Rel(gateway, chainlit, "return", "on_message returns immediately")

== Mediator Dispatches ==

Rel(queue, mediator, "event = await queue.get()")
Rel(mediator, domain, "dispatch(USER_MESSAGE)")

== Anthropic Tool Loop ==

Rel(domain, anthropic, "messages + system + tools")

loop until end_turn
    Rel(anthropic, gateway, "tool_use / text_delta / final_message")
    Rel(gateway, queue, "queue.put(Event(ANTHROPIC, ...))")
    Rel(queue, mediator, "event = await queue.get()")
    Rel(mediator, domain, "dispatch(TOOL_USE | TEXT_DELTA | TURN_COMPLETE)")
    Rel(domain, anthropic, "tool_result", "if tool_use")
    Rel(domain, chainlit, "stream token / render chart", "if text_delta or turn_complete")
end

== Turn Complete ==

Rel(mediator, queue, "await queue.get()", "blocks until next user message")

@enduml
