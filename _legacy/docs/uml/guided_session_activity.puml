@startuml guided_session_activity

skinparam backgroundColor #D3D3D3
skinparam defaultFontName Segoe UI

|User|
|App / Chainlit|
|AgentSession|
|Anthropic / Claude|

|App / Chainlit|
start
:on_chat_start;
:Scripted welcome message\n— no API call\n— sets scene, names the problem,\nsuggests first actions;

note right
  Free — no tokens spent.
  First impression of the tool
  is always fast and polished.
end note

|User|

repeat

  :Submit message;

  |AgentSession|
  :add_user_message();

  fork
    :Haiku classification call\n— "mechanical" or "reasoning"?\n— prompt: one-line classify only;
  fork again
    :Inject dynamic context\n(queues, roster,\nsolve registry summary);
    :Build system prompt\nwith tutorial or game loop\nsuffix based on turn_count;
  end fork

  note right
    Concurrent — classification
    and prompt assembly race.
    Net added latency near zero.
  end note

  if (classification == mechanical?) then (yes)
    :model = haiku\ne.g. define, solve,\nadd to roster;
  else (no — reasoning)
    :model = sonnet\ne.g. interpret results,\nsuggest improvements,\nnarrativise shortfall;
  endif

  :call tool_runner()\n— see agent_turn_activity\nfor inner loop detail;

  |Anthropic / Claude|
  :Reason;
  :Tool calls 0..n\n(solve, define, read etc);
  :Return final response;

  |AgentSession|

  note right
    Game loop the agent\nis steering toward:\nSee state → Make change\n→ Solve → See improvement\n→ repeat
  end note

  :Intercession check;

  if (asking about construction\nor how it was built?) then (yes)
    :Append about-me nudge\n+ link to docs;
  else if (short or vague message\nafter a solve?) then (yes — stuck)
    :Append re-entry nudge:\nsurface top remaining\nshortfall, invite next move;
  else if (out of scope request?) then (yes)
    :Append redirect:\n"outside what I do here —\nhere's what I can do";
  else (no intercession needed)
  endif

  :add_assistant_message();

  if (turn_count >= SUMMARISE_AFTER_TURNS?) then (yes)
    :conversation.summarise(client)\n— haiku compresses older turns;
  else (no)
    :conversation.trim();
  endif

  :Return response text;

  |App / Chainlit|
  :Render response;
  :Render charts if\nshow() was called\nthis turn;

  |User|

repeat while (session active?) is (yes)
-> no;

|App / Chainlit|
stop

@enduml