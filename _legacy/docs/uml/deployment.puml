@startuml deployment

skinparam backgroundColor #D3D3D3
skinparam defaultFontName Segoe UI

skinparam node {
    BackgroundColor #FAFAFA
    BorderColor #555555
    FontColor #222222
}
skinparam cloud {
    BackgroundColor #FAFAFA
    BorderColor #555555
    FontColor #222222
}
skinparam component {
    BackgroundColor #FAFAFA
    BorderColor #555555
    FontColor #222222
}
skinparam legend {
    BackgroundColor #FAFAFA
    BorderColor #555555
}

legend top right
  <#FAFAFA,#555555>|                                        |
  | Dev   | Client and Server on same machine               |
  | Prod  | Client: user device / Server: containerised     |
endlegend

node "Client" {
    [Browser] as Browser
}

node "Server" {
    [Chainlit + Python process] as App
}

cloud "Anthropic" {
    [Claude API] as Claude
}

Browser -right-> App : natural language\n(WebSocket)
App -left-> Browser : natural language\n+ Plotly figures

App -right-> Claude : prompt + tools + tool results\n(HTTPS)
Claude -left-> App : natural language\n+ tool calls

@enduml