@startuml architecture_component

skinparam backgroundColor #D3D3D3
skinparam defaultFontName Segoe UI

skinparam component {
    BackgroundColor #FAFAFA
    BorderColor #555555
    FontColor #222222
    BackgroundColor<<deferred>> #E8E8E8
    BorderColor<<deferred>> #AAAAAA
    FontColor<<deferred>> #AAAAAA
    BorderStyle<<deferred>> dashed
}

skinparam legend {
    BackgroundColor #FAFAFA
    BorderColor #555555
}

legend top right
  <#FAFAFA,#555555>|                          |
  | Solid component  | Implemented            |
  | <<deferred>>     | Planned / future       |
endlegend

package "Caller" <<Rectangle>> {
    [App / Chainlit] as App
}

note right of App
    chat.py seeds ScenarioContext by
    dispatching DEFAULT_COMMANDS
    from scenarios/default.py at startup.
    Chainlit surfaces agent responses
    and chart artifacts.
end note

package "Agent" <<Rectangle>> {
    [AgentSession] as AgentSession
    [AgentTools] as AgentTools
    [SystemPromptBuilder] as SPB
    [ConversationManager] as CM
}

package "Presentation" <<Rectangle>> {
    [ChartRenderer] as ChartRenderer
    note right of ChartRenderer
        Accepts SolveResult + chart_type.
        Returns Plotly figure or
        Chainlit element.
        No dependency on Engine or Agent
        internals — Domain types only.
    end note
    [TextRenderer] <<deferred>> as TextRenderer
}

package "Engine" <<Rectangle>> {
    [Dispatcher] as Dispatcher
    [Handler] as Handler
    [ScenarioContext] as Context
    [SolveResult] as SolveResult
}

package "Solver" <<Rectangle>> {
    [ErlangC] as ErlangC
    [ModelBuilder] as ModelBuilder
    [SolverOutput] as SolverOutput
    [CP-SAT Solver] as CPSAT
    [VarRegistry] as VarRegistry
}

package "Domain" <<Rectangle>> {
    [Entities] as Entities
    note right of Entities
        QueueProfile, SlotMatrix,
        Roster, RosterEntry
    end note
}

' ─────────────────────────────────────────
' INTERACTIONS
' ─────────────────────────────────────────

App --> AgentSession : user message
AgentSession --> AgentTools : get_tools()
AgentTools --> Dispatcher : ModelCommand (dispatch)
AgentTools --> Context : read (show tool)
AgentTools --> ChartRenderer : render(SolveResult, chart_type)
ChartRenderer --> App : Plotly figure / element

Dispatcher --> Handler : typed command
Handler --> Context : read / write
Handler --> ErlangC : derive demand
Handler --> ModelBuilder : delegate solve
ModelBuilder --> CPSAT : build and solve
ModelBuilder --> VarRegistry : index vars
ModelBuilder --> SolverOutput : returns
Handler --> SolveResult : assembles + writes to context

Agent ..> Domain : depends on
Engine ..> Domain : depends on
Solver ..> Domain : depends on
Presentation ..> Domain : depends on

@enduml